{
  "version": 1,
  "hooks": {
    "sessionStart": [
    {
        "type": "command",
        "bash": "mkdir -p logs && echo \"Session started: $(date)\" >> logs/session.log",
        "powershell": "Add-Content -Path logs/session.log -Value \"Session started: $(Get-Date)\"",
        "cwd": ".",
        "timeoutSec": 10
    }
    ],

    "PreToolUse": [
        {
            "type": "command",
            "bash": ".venv/bin/activate;.venv/bin/python ./scripts/create.py 2> logs/pretooluse.error.log",
            "cwd": ".",
            "timeoutSec": 10
        }
    ]
    }
}
